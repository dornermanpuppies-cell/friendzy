# ─────────────────────────────────────────────────────────────────────────────
# Friendzy — environment variables (names only, never commit real values)
#
# EXPO_PUBLIC_* variables are bundled into the web/Android/iOS client.
# Only ever put PUBLIC values here (Supabase anon key, public SDK keys, URLs).
# Secrets (service role key, LiveKit API secret, Resend key, RevenueCat secret
# keys, payment provider secrets) belong in Supabase Edge Function secrets —
# see supabase/.env.example and docs/CONFIGURATION.md.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (public — safe for clients; Row Level Security protects data)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# Website origin used for auth email redirects and share links (no trailing slash)
# Local web dev: http://localhost:8081   Production: https://friendzy.app
EXPO_PUBLIC_SITE_URL=http://localhost:8081
# Host used for iOS universal links / Android app links (optional until domain exists)
EXPO_PUBLIC_WEB_HOST=

# LiveKit (public WebSocket URL only — the API key/secret stay server-side)
EXPO_PUBLIC_LIVEKIT_URL=wss://<your-project>.livekit.cloud

# RevenueCat public SDK keys (public by design). Native builds only (development build / EAS).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Test Store key used during early testing with Expo development builds
EXPO_PUBLIC_REVENUECAT_TEST_KEY=

# GIF search in chats (Tenor API v2 key — optional; picker shows a notice when missing)
EXPO_PUBLIC_TENOR_API_KEY=

# Download page (website). Buttons appear only when a value exists — leave empty until real.
# Google Play / App Store listing URLs once the store apps are published:
EXPO_PUBLIC_PLAY_STORE_URL=
EXPO_PUBLIC_APP_STORE_URL=
# Direct Android .apk hosted elsewhere (overrides the GitHub release lookup below):
EXPO_PUBLIC_ANDROID_APK_URL=
# GitHub "owner/repository" whose latest "android-v…" release holds the APK built by
# .github/workflows/android-apk.yml. Netlify derives it from the connected repository; set it
# here for local runs. The link only works for visitors if that repository is public.
EXPO_PUBLIC_GITHUB_REPO=

# Expo / EAS (required for push notifications and store builds)
EAS_PROJECT_ID=
EXPO_OWNER=
