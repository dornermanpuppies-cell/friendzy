{
  "name": "friendzy",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev:build:android": "expo run:android",
    "dev:build:ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "web:export": "expo export --platform web",
    "web:serve": "npx serve dist -l 3000",
    "db:push": "supabase db push",
    "db:test": "node scripts/db-test.mjs",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.generated.ts",
    "functions:deploy": "supabase functions deploy livekit-token game-engine admin-actions && supabase functions deploy send-email revenuecat-webhook push-dispatch livekit-webhook --no-verify-jwt",
    "doctor": "expo-doctor",
    "db:combine": "bash scripts/db-combine.sh",
    "functions:deploy:livekit-webhook": "supabase functions deploy livekit-webhook --no-verify-jwt",
    "livekit:webhook:status": "node scripts/livekit-webhook.mjs status",
    "livekit:webhook:register": "node scripts/livekit-webhook.mjs register",
    "livekit:webhook:test": "node scripts/livekit-webhook.mjs test",
    "site:check": "node scripts/site-check.mjs",
    "qa:serve": "node scripts/qa/serve-dist.mjs dist --port 4173",
    "qa:e2e": "node scripts/qa/e2e.mjs",
    "functions:bundle": "node scripts/bundle-function.mjs game-engine && node scripts/bundle-function.mjs push-dispatch",
    "qa:hydration": "node scripts/qa/hydration-diff.mjs",
    "qa:scroll-audit": "node scripts/qa/scroll-audit.mjs",
    "qa:keyboard": "node scripts/qa/keyboard-check.mjs",
    "deploy:netlify": "node scripts/netlify-deploy.mjs dist"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/ui": "~58.0.29",
    "@expo/vector-icons": "^15.1.1",
    "@livekit/components-react": "^2.9.26",
    "@livekit/react-native": "^3.2.0",
    "@livekit/react-native-expo-plugin": "^1.2.0",
    "@livekit/react-native-webrtc": "^150.2.0",
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.2",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.2",
    "aes-js": "^3.1.2",
    "chess.js": "^1.4.0",
    "date-fns": "^4.4.0",
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "expo-video-thumbnails": "~58.0.3",
    "expo-web-browser": "~58.1.0",
    "livekit-client": "^2.25.0",
    "ngeohash": "^0.6.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-purchases": "^11.0.4",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/aes-js": "^3.1.4",
    "@types/jest": "^30.0.0",
    "@types/ngeohash": "^0.6.8",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.3.0",
    "embedded-postgres": "^19.0.0-beta.20",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "livekit-server-sdk": "^2.20.1",
    "pg": "^8.23.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@supabase/.*|livekit-server-sdk)"
    ]
  }
}
