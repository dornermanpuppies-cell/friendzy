# ─────────────────────────────────────────────────────────────────────────────
# Friendzy — SERVER-SIDE secrets (names only). Never ship these to clients.
#
# Push them to Supabase Edge Functions with:
#   supabase secrets set --env-file supabase/.env.local
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically into every Edge Function — do not set them manually.
# ─────────────────────────────────────────────────────────────────────────────

# LiveKit (calls + livestreams) — used only by the livekit-token function (minting room
# tokens) and the livekit-webhook function (verifying LiveKit's signed webhook requests).
# The webhook must be signed with this same key pair in the LiveKit dashboard.
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: only if the LiveKit dashboard signs webhooks with a different key than the one above
LIVEKIT_WEBHOOK_API_KEY=
LIVEKIT_WEBHOOK_API_SECRET=

# Resend (transactional email through the Supabase "Send Email" auth hook)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Friendzy <no-reply@your-verified-domain.com>
# Secret shown by Supabase when enabling the Send Email hook
# (Authentication → Hooks → Send Email). Format: v1,whsec_...
SEND_EMAIL_HOOK_SECRET=

# Public website origin used inside email templates
SITE_URL=https://friendzy.app

# RevenueCat — value of the Authorization header you configure on the webhook
# (Project → Integrations → Webhooks). Any long random string.
REVENUECAT_WEBHOOK_AUTH=
# Optional: secret API key (v1) for server-side subscriber lookups
REVENUECAT_SECRET_API_KEY=

# Push notifications — shared secret for the Database Webhooks that call push-dispatch
# (Database → Webhooks → header x-webhook-secret). Any long random string.
PUSH_WEBHOOK_SECRET=
# Optional but recommended: Expo access token for the push API (expo.dev → Access tokens)
EXPO_ACCESS_TOKEN=

# Card payments for the website (provider subject to approval; nothing is wired until configured)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
